{
  "$defs": {
    "CheckerBoard": {
      "properties": {
        "visual_type": {
          "const": "checkerboard",
          "title": "Visual Type",
          "type": "string"
        },
        "n_rows": {
          "default": 1.0,
          "title": "N Rows",
          "type": "number"
        },
        "n_columns": {
          "default": 1.0,
          "title": "N Columns",
          "type": "number"
        }
      },
      "required": [
        "visual_type"
      ],
      "title": "CheckerBoard",
      "type": "object"
    },
    "Gratings": {
      "properties": {
        "visual_type": {
          "const": "gratings",
          "title": "Visual Type",
          "type": "string"
        },
        "temporal_frequency": {
          "default": 1.0,
          "title": "Temporal Frequency",
          "type": "number"
        }
      },
      "required": [
        "visual_type"
      ],
      "title": "Gratings",
      "type": "object"
    },
    "KeyPress": {
      "properties": {
        "logic_type": {
          "const": "keypress",
          "title": "Logic Type",
          "type": "string"
        },
        "key_code": {
          "default": 13,
          "title": "Key Code",
          "type": "integer"
        }
      },
      "required": [
        "logic_type"
      ],
      "title": "KeyPress",
      "type": "object"
    },
    "LogicTransition": {
      "properties": {
        "alias": {
          "title": "Alias",
          "type": "string"
        },
        "transition": {
          "discriminator": {
            "mapping": {
              "keypress": "#/$defs/KeyPress",
              "timer": "#/$defs/Timer"
            },
            "propertyName": "logic_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Timer"
            },
            {
              "$ref": "#/$defs/KeyPress"
            }
          ],
          "title": "Transition"
        }
      },
      "required": [
        "alias",
        "transition"
      ],
      "title": "LogicTransition",
      "type": "object"
    },
    "State": {
      "properties": {
        "alias": {
          "title": "Alias",
          "type": "string"
        },
        "visual": {
          "$ref": "#/$defs/VisualStimulus"
        },
        "logic": {
          "$ref": "#/$defs/LogicTransition"
        },
        "transitions_to": {
          "title": "Transitions To",
          "type": "string"
        }
      },
      "required": [
        "alias",
        "visual",
        "logic",
        "transitions_to"
      ],
      "title": "State",
      "type": "object"
    },
    "Timer": {
      "properties": {
        "logic_type": {
          "const": "timer",
          "title": "Logic Type",
          "type": "string"
        },
        "due_time": {
          "default": 1.0,
          "title": "Due Time",
          "type": "number"
        }
      },
      "required": [
        "logic_type"
      ],
      "title": "Timer",
      "type": "object"
    },
    "VisualStimulus": {
      "properties": {
        "alias": {
          "title": "Alias",
          "type": "string"
        },
        "stimulus": {
          "discriminator": {
            "mapping": {
              "checkerboard": "#/$defs/CheckerBoard",
              "gratings": "#/$defs/Gratings"
            },
            "propertyName": "visual_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Gratings"
            },
            {
              "$ref": "#/$defs/CheckerBoard"
            }
          ],
          "title": "Stimulus"
        }
      },
      "required": [
        "alias",
        "stimulus"
      ],
      "title": "VisualStimulus",
      "type": "object"
    }
  },
  "properties": {
    "state_definitions": {
      "items": {
        "$ref": "#/$defs/State"
      },
      "title": "State Definitions",
      "type": "array"
    }
  },
  "required": [
    "state_definitions"
  ],
  "title": "StateMachine",
  "type": "object"
}